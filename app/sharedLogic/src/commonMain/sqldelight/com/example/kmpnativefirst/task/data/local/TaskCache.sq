import kotlin.Boolean;

CREATE TABLE cachedTask (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    notes TEXT,
    priority TEXT NOT NULL,
    dueAtEpochMillis INTEGER,
    isCompleted INTEGER AS Boolean NOT NULL,
    createdAtEpochMillis INTEGER NOT NULL,
    updatedAtEpochMillis INTEGER NOT NULL,
    revision INTEGER NOT NULL,
    syncState TEXT NOT NULL,
    isDeleted INTEGER AS Boolean NOT NULL,
    dueDate TEXT,
    projectId TEXT,
    labelIdsJson TEXT NOT NULL DEFAULT '[]'
);

CREATE TABLE taskOutbox (
    operationId TEXT NOT NULL PRIMARY KEY,
    taskId TEXT NOT NULL UNIQUE,
    kind TEXT NOT NULL,
    baseJson TEXT,
    desiredJson TEXT,
    enqueuedAtEpochMillis INTEGER NOT NULL
);

CREATE INDEX taskOutbox_enqueuedAt
ON taskOutbox(enqueuedAtEpochMillis);

CREATE TABLE taskConflict (
    taskId TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    baseJson TEXT,
    localJson TEXT,
    remoteJson TEXT,
    fields TEXT NOT NULL,
    detectedAtEpochMillis INTEGER NOT NULL
);

CREATE TABLE cachedTaskProject (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    color TEXT NOT NULL,
    createdAtEpochMillis INTEGER NOT NULL,
    updatedAtEpochMillis INTEGER NOT NULL,
    revision INTEGER NOT NULL,
    syncState TEXT NOT NULL,
    isDeleted INTEGER AS Boolean NOT NULL
);

CREATE TABLE taskProjectOutbox (
    operationId TEXT NOT NULL PRIMARY KEY,
    projectId TEXT NOT NULL UNIQUE,
    kind TEXT NOT NULL,
    baseJson TEXT,
    desiredJson TEXT,
    enqueuedAtEpochMillis INTEGER NOT NULL
);

CREATE INDEX taskProjectOutbox_enqueuedAt
ON taskProjectOutbox(enqueuedAtEpochMillis);

CREATE TABLE taskProjectConflict (
    projectId TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    baseJson TEXT,
    localJson TEXT,
    remoteJson TEXT,
    fields TEXT NOT NULL,
    detectedAtEpochMillis INTEGER NOT NULL
);

selectVisibleTasks:
SELECT *
FROM cachedTask
WHERE isDeleted = 0
ORDER BY
    isCompleted ASC,
    CASE WHEN dueDate IS NULL AND dueAtEpochMillis IS NULL THEN 1 ELSE 0 END,
    dueDate ASC,
    dueAtEpochMillis ASC,
    updatedAtEpochMillis DESC;

selectAllTasks:
SELECT *
FROM cachedTask;

selectTaskById:
SELECT *
FROM cachedTask
WHERE id = :id;

upsertTask:
INSERT OR REPLACE INTO cachedTask(
    id,
    title,
    notes,
    priority,
    dueAtEpochMillis,
    isCompleted,
    createdAtEpochMillis,
    updatedAtEpochMillis,
    revision,
    syncState,
    isDeleted,
    dueDate,
    projectId,
    labelIdsJson
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteTaskById:
DELETE FROM cachedTask
WHERE id = :id;

selectNextOutbox:
SELECT *
FROM taskOutbox
ORDER BY enqueuedAtEpochMillis ASC, operationId ASC
LIMIT 1;

selectAllOutbox:
SELECT *
FROM taskOutbox;

countOutbox:
SELECT COUNT(*)
FROM taskOutbox;

selectOutboxByTaskId:
SELECT *
FROM taskOutbox
WHERE taskId = :taskId;

selectOutboxByOperationId:
SELECT *
FROM taskOutbox
WHERE operationId = :operationId;

upsertOutbox:
INSERT OR REPLACE INTO taskOutbox(
    operationId,
    taskId,
    kind,
    baseJson,
    desiredJson,
    enqueuedAtEpochMillis
)
VALUES (?, ?, ?, ?, ?, ?);

deleteOutboxByTaskId:
DELETE FROM taskOutbox
WHERE taskId = :taskId;

deleteOutboxByOperationId:
DELETE FROM taskOutbox
WHERE operationId = :operationId;

selectConflicts:
SELECT *
FROM taskConflict
ORDER BY detectedAtEpochMillis DESC;

countConflicts:
SELECT COUNT(*)
FROM taskConflict;

selectConflictByTaskId:
SELECT *
FROM taskConflict
WHERE taskId = :taskId;

upsertConflict:
INSERT OR REPLACE INTO taskConflict(
    taskId,
    kind,
    baseJson,
    localJson,
    remoteJson,
    fields,
    detectedAtEpochMillis
)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteConflictByTaskId:
DELETE FROM taskConflict
WHERE taskId = :taskId;

selectVisibleProjects:
SELECT *
FROM cachedTaskProject
WHERE isDeleted = 0
ORDER BY name COLLATE NOCASE ASC;

selectAllProjects:
SELECT *
FROM cachedTaskProject;

selectProjectById:
SELECT *
FROM cachedTaskProject
WHERE id = :id;

upsertProject:
INSERT OR REPLACE INTO cachedTaskProject(
    id,
    name,
    color,
    createdAtEpochMillis,
    updatedAtEpochMillis,
    revision,
    syncState,
    isDeleted
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteProjectById:
DELETE FROM cachedTaskProject
WHERE id = :id;

selectNextProjectUpsertOutbox:
SELECT *
FROM taskProjectOutbox
WHERE kind != 'DELETE'
ORDER BY enqueuedAtEpochMillis ASC, operationId ASC
LIMIT 1;

selectNextProjectDeleteOutbox:
SELECT *
FROM taskProjectOutbox
WHERE kind = 'DELETE'
ORDER BY enqueuedAtEpochMillis ASC, operationId ASC
LIMIT 1;

selectAllProjectOutbox:
SELECT *
FROM taskProjectOutbox;

countProjectOutbox:
SELECT COUNT(*)
FROM taskProjectOutbox;

selectProjectOutboxByProjectId:
SELECT *
FROM taskProjectOutbox
WHERE projectId = :projectId;

upsertProjectOutbox:
INSERT OR REPLACE INTO taskProjectOutbox(
    operationId,
    projectId,
    kind,
    baseJson,
    desiredJson,
    enqueuedAtEpochMillis
)
VALUES (?, ?, ?, ?, ?, ?);

deleteProjectOutboxByProjectId:
DELETE FROM taskProjectOutbox
WHERE projectId = :projectId;

selectProjectConflicts:
SELECT *
FROM taskProjectConflict
ORDER BY detectedAtEpochMillis DESC;

countProjectConflicts:
SELECT COUNT(*)
FROM taskProjectConflict;

selectProjectConflictByProjectId:
SELECT *
FROM taskProjectConflict
WHERE projectId = :projectId;

upsertProjectConflict:
INSERT OR REPLACE INTO taskProjectConflict(
    projectId,
    kind,
    baseJson,
    localJson,
    remoteJson,
    fields,
    detectedAtEpochMillis
)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteProjectConflictByProjectId:
DELETE FROM taskProjectConflict
WHERE projectId = :projectId;
